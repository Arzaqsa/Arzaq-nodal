st.set_page_config(page_title="Arzaq Nodal Pro", layout="wide", page_icon="🛢️")
st.title("🛢️ Arzaq Nodal Pro - Multi-Correlation")
st.caption("IPR Vogel + VLP: Hagedorn-Brown, Gray, Beggs-Brill with Full Validation")

# ==================== 1. FUNCTIONS ====================
def calculate_pvt(API, Gas_Gravity, WC):
    rho_o = 141.5 / (API + 131.5) * 62.4
    rho_g = Gas_Gravity * 0.0764
    rho_w = 62.4
    f_o = (1 - WC/100)
    f_w = WC/100
    rho_mix = f_o * rho_o + f_w * rho_w
    return rho_mix

def vogel_ipr(Pr, Pb, PI, Pwf_array):
    Qmax = PI * Pr / 1.8
    Q = np.zeros_like(Pwf_array)
    for i, Pwf in enumerate(Pwf_array):
        if Pwf >= Pb:
            Q[i] = PI * (Pr - Pwf)
        else:
            Q_above = PI * (Pr - Pb)
            Q_below = Qmax * (1 - 0.2 * (Pwf/Pb) - 0.8 * (Pwf/Pb)**2)
            Q[i] = Q_above + Q_below
    return Q, Qmax

def vlp_hagedorn_brown(Q, inputs):
    rho_mix = calculate_pvt(inputs['API'], inputs['Gas_Gravity'], inputs['WC'])
    A = np.pi * (inputs['Tubing_ID']/12)**2 / 4
    v = Q * 5.615 / (A * 86400) if Q > 0 else 0.01
    P_vlp = inputs['P_wh'] + (rho_mix/144) * inputs['Depth'] + 0.001 * v**2 * inputs['Depth']
    return P_vlp

def vlp_gray(Q, inputs): # للغاز - مبسط
    rho_mix = calculate_pvt(inputs['API'], inputs['Gas_Gravity'], inputs['WC'])
    A = np.pi * (inputs['Tubing_ID']/12)**2 / 4
    v = Q * 5.615 / (A * 86400) if Q > 0 else 0.01
    P_vlp = inputs['P_wh'] + (rho_mix/144) * inputs['Depth'] * 0.8 + 0.002 * v**2 * inputs['Depth'] # معامل احتكاك اعلى للغاز
    return P_vlp

def vlp_beggs_brill(Q, inputs): # للنفط+غاز + المايل - مبسط
    rho_mix = calculate_pvt(inputs['API'], inputs['Gas_Gravity'], inputs['WC'])
    A = np.pi * (inputs['Tubing_ID']/12)**2 / 4
    v = Q * 5.615 / (A * 86400) if Q > 0 else 0.01
    Angle_factor = np.sin(np.radians(inputs['Angle'])) # عامل الميل
    P_vlp = inputs['P_wh'] + (rho_mix/144) * inputs['Depth'] * Angle_factor + 0.0015 * v**2 * inputs['Depth']
    return P_vlp

def objective(Q_guess, inputs, vlp_func):
    PI = inputs['PI']; Pr = inputs['Pr']; Pb = inputs['Pb']
    if Q_guess >= PI * (Pr - Pb):
        Pwf_guess = Pr - Q_guess/PI
    else:
        Qmax = PI * Pr / 1.8
        Pwf_guess = Pb * (1.25 - np.sqrt(0.5625 - 0.625 * Q_guess/Qmax))
    P_vlp = vlp_func(Q_guess, inputs)
    return Pwf_guess - P_vlp

# ==================== 2. VALIDATION ====================
def validate_inputs(inputs):
    errors = []
    if inputs['Pr'] <= 0: errors.append("Pr must be > 0")
    if inputs['Pb'] <= 0: errors.append("Pb must be > 0")
    if inputs['Pb'] > inputs['Pr']: errors.append("Pb cannot be greater than Pr")
    if inputs['P_wh'] > inputs['Pr']: errors.append("P_wh cannot be greater than Pr")
    if inputs['PI'] <= 0: errors.append("PI must be > 0")
    if inputs['Depth'] <= 0: errors.append("Depth must be > 0")
    if inputs['WC'] < 0 or inputs['WC'] > 100: errors.append("WC must be between 0 and 100")
    if inputs['GOR'] < 50 and inputs['Correlation'] == "Gray": errors.append("Gray correlation is for Gas wells. GOR is too low")
    if inputs['GOR'] > 5000 and inputs['Correlation'] == "Hagedorn-Brown": errors.append("H-B is for Oil wells. GOR is too high, use Gray")
    return errors

# ==================== 3. SIDEBAR ====================
with st.sidebar:
    st.header("1. Reservoir & Fluid")
    Pr = st.number_input("Pr (psi)", 1000.0, 15000.0, 5000.0)
    Pb = st.number_input("Pb (psi)", 500.0, 10000.0, 3000.0)
    PI = st.number_input("PI (STB/d/psi)", 0.1, 50.0, 8.22)
    GOR = st.number_input("GOR (scf/STB)", 50.0, 10000.0, 500.0)
    API = st.number_input("API", 10.0, 50.0, 35.0)
    Gas_Gravity = st.number_input("Gas Gravity", 0.5, 1.5, 0.7)
    WC = st.number_input("WC %", 0.0, 100.0, 0.0)

    st.header("2. Well Data")
    Depth = st.number_input("Depth (ft)", 1000.0, 20000.0, 8000.0)
    Tubing_ID = st.number_input("Tubing ID (in)", 1.0, 6.0, 2.88)
    P_wh = st.number_input("P_wh (psi)", 50.0, 5000.0, 500.0)
    Angle = st.number_input("Well Angle (deg)", 0.0, 90.0, 90.0, help="90 = Vertical")

    st.header("3. Correlation")
    Correlation = st.selectbox("VLP Correlation", ["Hagedorn-Brown - Oil", "Gray - Gas", "Beggs-Brill - Oil+Gas/Deviated"])

inputs = {'Pr':Pr,'Pb':Pb,'PI':PI,'GOR':GOR,'API':API,'Gas_Gravity':Gas_Gravity,'WC':WC,
          'Depth':Depth,'Tubing_ID':Tubing_ID,'P_wh':P_wh,'Angle':Angle,'Correlation':Correlation}

# ==================== 4. RUN ====================
if st.button("Run Analysis", type="primary", use_container_width=True):

    errors = validate_inputs(inputs)
    if errors:
        for e in errors: st.error(f"❌ Validation Error: {e}")
        st.stop()

    with st.spinner("Calculating..."):
        P_ipr = np.linspace(0, Pr, 100)
        Q_ipr, Qmax = vogel_ipr(Pr, Pb, PI, P_ipr)

        if "Hagedorn" in Correlation: vlp_func = vlp_hagedorn_brown
        elif "Gray" in Correlation: vlp_func = vlp_gray
        else: vlp_func = vlp_beggs_brill

        Q_nodal = fsolve(objective, Qmax/2, args=(inputs, vlp_func))[0]
        Pwf_nodal = Pr - (Q_nodal/PI)*1.8
        Pwf_nodal = max(0, min(Pwf_nodal, Pr))

    st.success("Analysis Complete!")
    col1, col2, col3 = st.columns(3)
    col1.metric("AOF", f"{Qmax:,.0f} STB/d")
    col2.metric("Nodal Rate", f"{Q_nodal:,.0f} STB/d")
    col3.metric("Nodal Pwf", f"{Pwf_nodal:,.0f} psi")

    # Plotting
    fig, ax = plt.subplots(figsize=(10,6))
    ax.plot(Q_ipr, P_ipr, 'b-', linewidth=2.5, label="IPR - Vogel")
    Q_vlp = np.linspace(0, Qmax*1.2, 100)
    P_vlp = [vlp_func(q, inputs) for q in Q_vlp]
    ax.plot(Q_vlp, P_vlp, 'r-', linewidth=2.5, label=f"VLP - {Correlation}")
    ax.plot(Q_nodal, Pwf_nodal, 'ro', markersize=12, label=f"Operating Point")
    ax.set_xlabel("Q (STB/day)"); ax.set_ylabel("Pressure (psi)")
    ax.set_title("Nodal Analysis"); ax.legend(); ax.grid(True); ax.invert_yaxis()
    st.pyplot(fig)

    st.info("Note: VLP Correlations are simplified for demo. For production use, add full H-B, Gray, B-B equations")
